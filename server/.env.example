# Path to the SQLite database file, created automatically on first run.
# Lives alongside LOCAL_STORAGE_DIR so a full backup is just: cp -r data/ backup/
DATABASE_URL=./data/shareblog.db

# Port the Fastify server listens on.
PORT=3000

# Base domain sites are served under: <subdomain>.<BASE_DOMAIN>
# Local dev: use *.localhost, which resolves automatically with no /etc/hosts changes.
BASE_DOMAIN=localhost:3000

# Base host the API is served under (kept separate from the tenant-routed site host).
API_BASE_URL=http://api.localhost:3000

# local | s3  (s3 not implemented yet — placeholder for later)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads

# development | production
# In development, auth codes/links are logged to the console instead of emailed.
NODE_ENV=development

# Only read when NODE_ENV=production. Uberspace provides SMTP as part of hosting.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Shareblog <noreply@example.com>

# Optional — used as a secondary fallback if Open Library returns no results.
GOOGLE_BOOKS_API_KEY=

# Comma-separated list of emails allowed to sign in / create an account.
# Required when NODE_ENV=production — the server refuses to boot without it
# (see server.ts), since without it anyone who finds the API could create
# their own account and site on this box. Leave unset for local dev, where
# that doesn't matter.
ALLOWED_SIGNUP_EMAILS=
